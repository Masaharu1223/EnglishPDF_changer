# 翻訳(Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# 音声合成(ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Neon(Postgres)
# DATABASE_URL / DATABASE_URL_UNPOOLED: Neonダッシュボードから取得する所有者ロールの
#   接続文字列。マイグレーション(scripts/migrate.mjs)専用。アプリの実行時には使わない
# DATABASE_URL_APP: scripts/migrate.mjs の初回実行時に自動生成・設定される、権限を
#   絞ったapp_userロールの接続文字列。アプリはこちらを使う
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_URL_APP=

# 認証(Better Auth + Google OAuth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
